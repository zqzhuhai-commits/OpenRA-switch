+[mono]
+; Enable mononx logging messages
+logging = false
+; Enable logging from mono's internal logging engine
+runtime_logging = false
+; Runtime files
+icu = /mono/etc/icudt77l.dat
+assembly_dir = "/mono/lib_net9.0;/mono/framework_net9.0"
+config_dir = /mono/etc
+; OpenRA launcher entry point
+default_assembly  = /mono/openra/OpenRA.dll
+; Launch directly into the Red Alert mod instead of the mod chooser
+default_args = Game.Mod=ra
+; Enable remote debugging. When this is true mono will listen with the software debugger on port 55555.
+;enable_debug_server = true
+
+[nx]
+; Redirect all I/O to a log file on the sd card (diagnostics)
+file_io_redirect = /mono/log.txt
+; This is an ugly hack. Currently mono can't reload in the same process. This means that closing the
+; interpreter nro and opening it again will crash. This flag causes the wrapper to call svcExitProcess
+; on exit, terminating the hbmenu as well so the next time we can start fresh
+exit_process_on_end = true
+; OpenGL/Mesa cannot initialize in applet mode (mono reserves half the heap).
+; This flag forces the app to only run as a full application via title takeover:
+; on the HOME menu, hold R while launching any game to open hbmenu with full
+; resources, then launch OpenRA from there. When launched from the Album applet,
+; a clear error message is shown instead of a silent crash.
+force_full_application = true
