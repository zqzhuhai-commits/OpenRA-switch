+		public static void SyncClientToPlayerReference(Session.Client c, PlayerReference pr)
+		{
+			if (pr == null)
+				return;
+
+			if (pr.LockFaction)
+				c.Faction = pr.Faction;
+			if (pr.LockSpawn)
+				c.SpawnPoint = pr.Spawn;
+			if (pr.LockTeam)
+				c.Team = pr.Team;
+			if (pr.LockHandicap)
+				c.Handicap = pr.Handicap;
+
+			c.Color = pr.LockColor ? pr.Color : c.PreferredColor;
