<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup Condition="'$(CecilDir)' == ''">
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
  <ItemGroup Condition="'$(CecilDir)' != ''">
    <Reference Include="$(CecilDir)/Mono.Cecil.dll" />
    <Reference Include="$(CecilDir)/Mono.Cecil.Rocks.dll" />
  </ItemGroup>
</Project>
